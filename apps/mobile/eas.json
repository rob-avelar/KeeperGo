{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "developmentClient": false,
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "ios": {
        "simulator": false,
        "buildConfiguration": "Release"
      },
      "channel": "preview",
      "env": {
        "YARN_ENABLE_IMMUTABLE_INSTALLS": "false",
        "NODE_ENV": "production"
      }
    },
    "production": {
      "autoIncrement": true,
      "developmentClient": false,
      "channel": "production",
      "ios": {
        "distribution": "store",
        "buildConfiguration": "Release"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
