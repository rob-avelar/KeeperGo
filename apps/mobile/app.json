{
  "expo": {
    "name": "KeeperGo",
    "slug": "keepergo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "keepergo",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#111827"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "nl.keepergo.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "KeeperGo uses your location to find goalkeepers near you.",
        "NSCameraUsageDescription": "KeeperGo uses your camera to upload your profile photo.",
        "NSPhotoLibraryUsageDescription": "KeeperGo accesses your photos to upload your profile photo.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "nl.keepergo.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#a3e635"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "KeeperGo uses your location to find goalkeepers near you."
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.nl.keepergo",
          "enableGooglePay": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "9b93a316-25b4-4cf0-aebc-3af763973004"
      }
    }
  }
}
