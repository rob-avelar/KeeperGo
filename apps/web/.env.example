# ─── KeeperGo Web — Exemplo de Variáveis de Ambiente ────────────────────────
# Copie este arquivo para .env.local e preencha com suas credenciais reais
# NUNCA commit .env.local (já está no .gitignore)

# ─── Banco de dados ─────────────────────────────────────────────────────────
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO
DATABASE_URL=postgresql://usuario:senha@host:5432/keepergo

# ─── NextAuth ────────────────────────────────────────────────────────────────
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=seu_segredo_aleatorio_base64_aqui
NEXTAUTH_URL=https://www.keepergo.nl

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Crie em: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=seu_google_client_id_aqui
GOOGLE_CLIENT_SECRET=seu_google_client_secret_aqui

# ─── Stripe (Live para produção, test para desenvolvimento) ──────────────────
# Encontre em: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_... ou sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_live_... ou pk_test_...
# Webhook secret em: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── AWS S3 (upload de fotos de perfil) ──────────────────────────────────────
# Se usar perfil gerido (hosted_storage):
AWS_S3_BUCKET=nome-do-bucket
AWS_REGION=regiao-do-bucket
AWS_FOLDER_PREFIX=prefixo/opcional/

# Se usar chaves AWS tradicionais (não recomendado para produção):
# AWS_ACCESS_KEY_ID=sua_chave_aqui
# AWS_SECRET_ACCESS_KEY=seu_segredo_aqui
