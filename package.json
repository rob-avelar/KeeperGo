{
  "name": "keepergo-monorepo",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:generate": "yarn workspace @keepergo/database run db:generate",
    "db:push": "yarn workspace @keepergo/database run db:push",
    "db:seed": "yarn workspace @keepergo/database run seed",
    "web": "yarn workspace @keepergo/web run dev",
    "mobile": "yarn workspace @keepergo/mobile run dev"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "5.2.2"
  }
}
